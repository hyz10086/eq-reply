# ============================================================
# 高情商回复生成器 环境变量示例
# 使用：复制本文件为 .env 并填入实际值（.env 已被 .gitignore 排除）
# ============================================================

# DeepSeek API 密钥（必填，除非 MOCK_MODE=1）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型接口（默认 DeepSeek；任何 OpenAI 兼容服务只需改这两个值即可切换）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Mock 模式：1 = 不调用真实模型，返回本地样例回复（本地演示/无密钥自测用）
MOCK_MODE=0
# Mock 模式下的模拟延迟（毫秒），便于观察加载状态
MOCK_DELAY_MS=300

# 服务端口
PORT=3000

# 输入长度上限（字符数；前端实时显示并拦截超限，服务端兜底校验，不静默截断）
MAX_INPUT_LENGTH=2000

# 限流：每个 IP 每分钟允许的生成请求数
RATE_LIMIT_PER_MIN=6

# 模型调用超时（毫秒）
MODEL_TIMEOUT_MS=25000
